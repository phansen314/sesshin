{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "selector",
  "type": "string",
  "anyOf": [
    { "pattern": "^[1-9][0-9]{0,15}$" },
    { "pattern": "^[0-9A-Fa-f-]{8,36}$" },
    { "const": "self" },
    { "pattern": "^(job:)?(?![0-9]+$)[A-Za-z0-9](?:[A-Za-z0-9-]{0,62}[A-Za-z0-9])?$" }
  ]
}
