{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "usage-details",
  "type": "object",
  "required": ["problems"],
  "properties": {
    "problems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["reason"],
        "properties": {
          "argument": { "type": "string", "description": "The offending token, when the parser names one." },
          "reason": { "type": "string", "description": "Human-readable." }
        }
      }
    }
  }
}
